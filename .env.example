# JARVIS Assistant - Environment Configuration
# Copy this to .env and fill in your values

# ============================================
# LLM Backend Configuration
# ============================================
# Primary backend: nvidia_nim | openrouter
PRIMARY_BACKEND=nvidia_nim

# NVIDIA NIM (Fast lightweight models via NVIDIA NIM)
NVIDIA_NIM_API_KEY=your-nvidia-nim-api-key
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=nvidia/nemotron-3-super-120b-a12b

# OpenRouter (free/paid models)
OPENROUTER_API_KEY=your-openrouter-key

# Fallback order (used when primary fails)
# Comma-separated, no spaces
FALLBACK_BACKENDS=openrouter

# ============================================
# Application Configuration
# ============================================
# Database
JARVIS_DB=jarvis.db

# Logging
LOG_LEVEL=INFO

# Voice
VOICE_ENABLED=false

# FastAPI Server (Python backend)
API_HOST=127.0.0.1
API_PORT=8765

# ============================================
# External API Keys (for tools)
# ============================================
# OpenWeatherMap (for weather tool)
OPENWEATHER_API_KEY=your-openweather-key

# Brave Search (for web search tool)
BRAVE_API_KEY=your-brave-key

# SerpAPI (alternative web search)
SERPAPI_KEY=your-serpapi-key