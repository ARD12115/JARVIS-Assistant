# JARVIS Assistant - Environment Configuration
# Copy this to .env and fill in your values

# ============================================
# LLM Backend Configuration
# ============================================
# Primary backend: runpod | ollama | openrouter | anthropic
PRIMARY_BACKEND=runpod

# RunPod (vLLM OpenAI-compatible endpoint)
RUNPOD_ENDPOINT=https://your-runpod-endpoint.runpod.io
RUNPOD_TOKEN=your-runpod-api-token

# Ollama (local)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# OpenRouter (free/paid models)
OPENROUTER_API_KEY=your-openrouter-key

# Anthropic (Claude)
ANTHROPIC_API_KEY=your-anthropic-key

# Fallback order (used when primary fails)
# Comma-separated, no spaces
FALLBACK_BACKENDS=ollama,openrouter

# ============================================
# Application Configuration
# ============================================
# Database
JARVIS_DB=jarvis.db

# Logging
LOG_LEVEL=INFO

# Voice
VOICE_ENABLED=false

# FastAPI Server (Python backend)
API_HOST=127.0.0.1
API_PORT=8765

# ============================================
# External API Keys (for tools)
# ============================================
# OpenWeatherMap (for weather tool)
OPENWEATHER_API_KEY=your-openweather-key

# Brave Search (for web search tool)
BRAVE_API_KEY=your-brave-key

# SerpAPI (alternative web search)
SERPAPI_KEY=your-serpapi-key