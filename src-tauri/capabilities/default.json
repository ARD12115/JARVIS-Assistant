{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "Default capabilities for JARVIS Assistant",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "core:event:allow-emit-to",
    "core:event:allow-emit-filter",
    "core:event:allow-emit-to-filter",
    "core:window:allow-set-title",
    "core:window:allow-maximize",
    "core:window:allow-minimize",
    "core:window:allow-unmaximize",
    "core:window:allow-unminimize",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-fullscreen",
    "core:window:allow-set-resizable",
    "core:window:allow-start-dragging",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-request-user-attention",
    "core:window:allow-set-decorations",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-content-protection",
    "core:window:allow-set-skip-taskbar",
    "core:window:allow-set-icon",
    "core:window:allow-set-cursor-icon",
    "core:window:allow-set-cursor-grab",
    "core:window:allow-set-cursor-visible",
    "shell:allow-open",
    "shell:allow-execute",
    "shell:allow-sidecar",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-copy-file",
    "fs:allow-create-dir",
    "fs:allow-remove-file",
    "fs:allow-remove-dir",
    "fs:allow-rename-file",
    "fs:allow-exists",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "http:allow-request",
    "http:allow-response",
    "http:allow-send",
    "http:allow-stream",
    "notification:allow-show",
    "notification:allow-hide",
    "os:allow-get-platform",
    "os:allow-get-version",
    "process:allow-exit",
    "process:allow-relaunch",
    "process:allow-restart"
  ]
}