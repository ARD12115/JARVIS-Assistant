{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JARVIS Assistant",
  "version": "0.1.0",
  "identifier": "com.jarvis.assistant",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../src-frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "JARVIS Assistant",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8765 ws://127.0.0.1:8765 https://api.openweathermap.org https://api.search.brave.com https://serpapi.com; img-src 'self' data: blob:; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data: https://fonts.gstatic.com;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "shell": { "open": true },
    "fs": { "requireLiteralLeadingDot": true },
    "dialog": { "open": true, "save": true },
    "clipboard-manager": { "write": true },
    "global-shortcut": { "all": false },
    "process": { "scope": [] }
  }
}